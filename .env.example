# Copy to .env and adjust as needed. config.py falls back to sane local
# defaults for everything here, so .env is optional for local dev.

# --- Database ---
DATABASE_URL=postgresql+psycopg2://dqe:dqe@localhost:5433/dqe

# --- Alerting (Slack) ---
# Leave blank to run with alerting mocked/disabled (see scheduler/alerts.py).
SLACK_WEBHOOK_URL=
ALERT_HEALTH_SCORE_THRESHOLD=70

# --- Scheduler ---
# Files dropped in WATCH_FOLDER are picked up automatically and processed
# the same way as a dashboard upload; on success they land in PROCESSED_FOLDER,
# on failure (unsupported type, unreadable, OCR found 0 rows) in FAILED_FOLDER.
SCHEDULER_ENABLED=true
WATCH_FOLDER=./data/incoming
PROCESSED_FOLDER=./data/processed
FAILED_FOLDER=./data/failed
SCHEDULER_INTERVAL_MINUTES=60
